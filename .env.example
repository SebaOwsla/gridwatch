# Copy to .env and fill in the two required secrets before running services.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173
# Para acceso desde el celular, usa la IPv4 local del computador (misma red Wi-Fi).
# El valor predeterminado 127.0.0.1 deja la web accesible solo en este equipo.
GRIDWATCH_WEB_BIND_IP=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=127.0.0.1,localhost

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=gridwatch
POSTGRES_USER=gridwatch
POSTGRES_PASSWORD=

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=gridwatch/demo
MQTT_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=2

JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_TTL_MINUTES=30
